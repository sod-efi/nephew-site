#!/bin/sh
# nephew installer — fetches the release tarball, verifies its sha256
# against the published SHA256SUMS, and installs:
#   app payload  -> ${NEPHEW_HOME:-~/.local/lib/nephew}
#   launcher     -> ${NEPHEW_INSTALL_DIR:-~/.local/bin}/nephew
# Nothing else is written. No sudo. Fails closed on any mismatch.
set -eu

VERSION="0.5.3"
TARBALL="nephew-v${VERSION}.tar.gz"
# The tarball's sha256, written into the published copy of this script by
# the release build. SHA256SUMS is fetched from the same place as the
# tarball, so on its own it only proves the download arrived intact;
# this pin ties the installer the user read to the bytes it installs.
PINNED_SHA256="1b31bef0b35b414c1ffa0e989a45e3f340c26a59eb033d509d454857a0739eb6"
BASE="${NEPHEW_INSTALL_BASE:-https://nephew.ai/releases}"
APP_DIR="${NEPHEW_HOME:-$HOME/.local/lib/nephew}"
BIN_DIR="${NEPHEW_INSTALL_DIR:-$HOME/.local/bin}"

# The CLI is TypeScript executed by Node's type stripping, on by default
# from Node 22.18 (and 23.6): earlier 22.x installs fail at first run.
if ! command -v node >/dev/null 2>&1; then
  echo "nephew: Node.js >= 22.18 is required but was not found on PATH" >&2
  exit 1
fi
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
NODE_MINOR="$(node -p 'process.versions.node.split(".")[1]')"
if [ "$NODE_MAJOR" -lt 22 ] || { [ "$NODE_MAJOR" -eq 22 ] && [ "$NODE_MINOR" -lt 18 ]; }; then
  echo "nephew: Node.js >= 22.18 is required (found $(node --version))" >&2
  exit 1
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT INT TERM

echo "downloading ${BASE}/${TARBALL}"
curl -fsSL "${BASE}/${TARBALL}" -o "${WORK}/${TARBALL}"
curl -fsSL "${BASE}/SHA256SUMS" -o "${WORK}/SHA256SUMS"

EXPECTED="$(awk -v t="${TARBALL}" '$2 == t {print $1}' "${WORK}/SHA256SUMS")"
if [ -z "${EXPECTED}" ]; then
  echo "nephew: SHA256SUMS has no entry for ${TARBALL} — refusing to install" >&2
  exit 1
fi
case "${PINNED_SHA256}" in
  "{{"*) ;; # an unbuilt copy of this script (the repo's template) carries no pin
  "${EXPECTED}") ;;
  *)
    echo "nephew: SHA256SUMS (${EXPECTED}) disagrees with the sha256 pinned in this installer (${PINNED_SHA256}) — refusing to install" >&2
    exit 1 ;;
esac
if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL="$(sha256sum "${WORK}/${TARBALL}" | awk '{print $1}')"
else
  ACTUAL="$(shasum -a 256 "${WORK}/${TARBALL}" | awk '{print $1}')"
fi
if [ "${ACTUAL}" != "${EXPECTED}" ]; then
  echo "nephew: sha256 mismatch for ${TARBALL} — refusing to install" >&2
  echo "  expected ${EXPECTED}" >&2
  echo "  got      ${ACTUAL}" >&2
  exit 1
fi

mkdir -p "${WORK}/x"
tar -xzf "${WORK}/${TARBALL}" -C "${WORK}/x"
rm -rf "${APP_DIR}"
mkdir -p "$(dirname "${APP_DIR}")" "${BIN_DIR}"
mv "${WORK}/x/nephew-${VERSION}" "${APP_DIR}"

cat > "${BIN_DIR}/nephew" <<EOF
#!/bin/sh
exec node "${APP_DIR}/bin/nephew.js" "\$@"
EOF
chmod +x "${BIN_DIR}/nephew"

echo "installed   nephew v${VERSION} -> ${BIN_DIR}/nephew"
echo "verified    sha256 ${ACTUAL}"
echo "yours       app + profiles live under ${APP_DIR} and your bundle dir — no nephew server holds them"
case ":${PATH}:" in
  *":${BIN_DIR}:"*) ;;
  *) echo "path        ${BIN_DIR} is not on your PATH yet — add it:  export PATH=\"${BIN_DIR}:\$PATH\"" ;;
esac
echo "next step:  nephew init"
